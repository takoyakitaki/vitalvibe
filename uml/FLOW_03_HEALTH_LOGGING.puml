@startuml VitalVibe_Health_Logging_Flow
!theme plain
skinparam backgroundColor #ffffff
skinparam ArrowColor #0ea5e9
skinparam ActivityBorderColor #0ea5e9
skinparam ActivityBackgroundColor #f0f9ff

title VitalVibe - Health Logging Flow (บันทึกสุขภาพ)

actor User as user
participant "Health Page\n(health.html)" as health_page
participant "Firestore\nDatabase" as firestore

user -> health_page: เข้าหน้า Health Logging
activate health_page

health_page -> firestore: ดึงข้อมูล Latest\nhealth logs\nของ user
activate firestore
firestore -> health_page: Return last log\n(weight, sugar, pressure)
deactivate firestore

health_page -> health_page: แสดง Latest Card:\n- Latest value\n- Latest date\n- Status icon

user -> health_page: กดเลือก Type Tab
alt เลือก "⚖️ น้ำหนัก (Weight)"
  health_page -> health_page: แสดง Form:\n- Weight (kg)\n- Unit selector
  
  user -> health_page: กรอก Weight
  user -> health_page: กดปุ่ม "💾 บันทึก"
  
  health_page -> firestore: addDoc(collection: 'healthLogs',\n{\n  uid: session.uid,\n  type: 'weight',\n  weight: 75.5,\n  date: today,\n  createdAt: now\n})
  activate firestore
  firestore -> health_page: Save success
  deactivate firestore
  
  health_page -> firestore: ดึง all weight logs\n(จาก History Range:\nรายวัน/รายเดือน/รายปี)
  activate firestore
  firestore -> health_page: Return all logs
  deactivate firestore
  
  health_page -> health_page: แสดง History List:\n- Weight → Date\n- ไหล่ปัจจุบัน vs ก่อนหน้า
  
else เลือก "🩸 น้ำตาล (Sugar)"
  health_page -> health_page: แสดง Form:\n- Sugar Level (mg/dL)\n- Before/After meal
  user -> health_page: กรอก Sugar + ระบุเมื่อไหร่
  user -> health_page: กดปุ่ม "💾 บันทึก"
  
  health_page -> firestore: addDoc('healthLogs',\n{\n  type: 'sugar',\n  sugar: 150,\n  mealTiming: 'before',\n  ...\n})
  activate firestore
  firestore -> health_page: Save success
  deactivate firestore
  
else เลือก "💓 ความดัน (Pressure)"
  health_page -> health_page: แสดง Form:\n- Systolic (ตัวบน)\n- Diastolic (ตัวล่าง)
  user -> health_page: กรอก Pressure values
  user -> health_page: กดปุ่ม "💾 บันทึก"
  
  health_page -> firestore: addDoc('healthLogs',\n{\n  type: 'pressure',\n  systolic: 120,\n  diastolic: 80,\n  ...\n})
  activate firestore
  firestore -> health_page: Save success
  deactivate firestore
end

health_page -> health_page: อัปเดต Latest Card\nจาก new log

user -> health_page: เปลี่ยน History Range\n(รายวัน/เดือน/ปี/ทั้งหมด)
health_page -> firestore: query(type, dateRange)
activate firestore
firestore -> health_page: Return filtered logs
deactivate firestore

health_page -> health_page: แสดง History List\nแบบ Updated

deactivate health_page

@enduml
