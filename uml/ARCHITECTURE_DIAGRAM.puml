@startuml VitalVibe_System_Architecture
!theme plain
skinparam backgroundColor #ffffff
skinparam ArrowColor #333333
skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #e1f5ff

title VitalVibe - ระบบติดตามสุขภาพบน LINE OA

package "Frontend - LINE LIFF Apps" #fff9e6 {
  rectangle "🍱 Food Page\n(food.html)" as food
  rectangle "📋 Health Page\n(health.html)" as health
  rectangle "🏆 Missions Page\n(missions.html)" as missions
  rectangle "👤 Profile Page\n(profile.html)" as profile
  rectangle "⏰ Reminders Page\n(reminders.html)" as reminders
  rectangle "🔑 Login Page\n(login.html)" as login
}

package "Core Libraries" #e8f5e9 {
  rectangle "Auth Handler\n(lib/auth.js)" as auth_lib
  rectangle "Firebase Config\n(lib/firebase.js)" as firebase_lib
}

package "Firebase Backend" #f3e5f5 {
  rectangle "🔐 Authentication\n(Email/Password)" as firebase_auth
  rectangle "🗄️ Firestore Database" as firestore
}

package "External Services" #ffe0b2 {
  rectangle "🤖 Google Gemini API\n(Food Analysis)" as gemini
  rectangle "📱 LINE Messaging API\n(Rich Menu, LIFF)" as line_api
}

package "Admin Panel" #ffebee {
  rectangle "🛠️ Admin Dashboard\n(admin/index.html)" as admin
}

' Connections
login --> auth_lib: Check session
login --> firebase_auth: Register/Login
auth_lib --> food: requireAuth()
auth_lib --> health: requireAuth()
auth_lib --> missions: requireAuth()
auth_lib --> profile: requireAuth()
auth_lib --> reminders: requireAuth()

firebase_lib --> firebase_auth: Initialize
firebase_lib --> firestore: Get Database

food --> firestore: Save Food Logs
food --> gemini: Analyze Food Image
health --> firestore: Save Health Logs
missions --> firestore: Load/Complete Missions
profile --> firestore: Save Profile & Wallet
reminders --> firestore: Load/Save Reminders

firestore --> admin: Read All Collections
admin --> firestore: CRUD Operations

line_api --> login: Deep Link to Login
line_api --> food: Deep Link to Food
line_api --> health: Deep Link to Health
line_api --> missions: Deep Link to Missions
line_api --> profile: Deep Link to Profile

@enduml
