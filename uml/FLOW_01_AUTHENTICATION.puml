@startuml VitalVibe_Authentication_Flow
!theme plain
skinparam backgroundColor #ffffff
skinparam ArrowColor #14b8a6
skinparam ActivityBorderColor #14b8a6
skinparam ActivityBackgroundColor #f0fdf4
skinparam NoteBkgColor #fff9e6

title VitalVibe - Authentication Flow (การเข้าสู่ระบบ)

actor User as user
participant "LINE Rich Menu" as line_menu
participant "Login Page\n(login.html)" as login_page
participant "Firebase Auth\n(Email/Password)" as firebase
participant "Session Storage\n(sessionStorage)" as session
participant "Protected Page\n(food/health/etc)" as protected

user -> line_menu: กดปุ่มจาก Rich Menu
activate line_menu
line_menu -> login_page: LIFF Deep Link redirect
deactivate line_menu

activate login_page
alt User มี Session แล้ว
  login_page -> session: getSession()
  login_page -> protected: redirect ไปหน้าเดิม ✅
else ไม่มี Session
  user -> login_page: กรอก Email & Password
  login_page -> firebase: signInWithEmailAndPassword()
  activate firebase
  firebase -> firebase: Validate Credentials
  alt Login สำเร็จ
    firebase -> firebase: Return user object
    firebase -> login_page: user.uid, user.email
    deactivate firebase
    login_page -> session: saveSession({\n  uid, displayName,\n  avatar, lineUid\n})
    activate session
    note right: เก็บใน sessionStorage\n(หาย เมื่อปิด tab)
    deactivate session
    login_page -> protected: redirect ไปหน้าที่ขอ ✅
  else Login ล้มเหลว
    firebase -> login_page: Error (user-not-found,\nwrong-password)
    deactivate firebase
    login_page -> user: แสดง Error message ❌
  end
end

alt User เลือก "สมัครสมาชิก"
  user -> login_page: กรอก Name, Email, Password
  login_page -> firebase: createUserWithEmailAndPassword()
  activate firebase
  firebase -> firebase: Create new user
  firebase -> firebase: updateProfile(user,\n{displayName: name})
  alt Register สำเร็จ
    firebase -> login_page: user.uid, user.email
    login_page -> session: persistUser()\n& saveSession()
    deactivate firebase
    login_page -> protected: redirect ✅
  else Register ล้มเหลว
    firebase -> login_page: Error (email-already-in-use,\nweak-password)
    deactivate firebase
    login_page -> user: แสดง Error ❌
  end
end

deactivate login_page

@enduml
